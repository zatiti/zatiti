{
  "manifest_version": 3,
  "name": "Zatiti",
  "version": "0.1.0",
  "description": "Chat with a governed Zatiti agent from any Chrome tab.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms",
    "debugger",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:*"
  }
}
